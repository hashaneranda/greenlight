ENVIRONMENT=local
DATABASE_URL=sqlite:///./greenlight.db
SECRET_KEY=change-me
BASE_URL=http://localhost:8000
SIGN_IN=demo
# Optional passcode for the demo persona picker
DEMO_PASSCODE=

# Microsoft Entra ID sign-in (SIGN_IN=entra)
ENTRA_TENANT_ID=
